{
  "name": "cockpit",
  "version": "2.5.52",
  "private": true,
  "workspaces": [
    "apps/*",
    "modules/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "cd apps/api && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "build": "cd apps/web && bun run build"
  },
  "devDependencies": {
    "@types/ioredis": "^5.0.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@hono/zod-openapi": "^1.2.2",
    "@scalar/hono-api-reference": "^0.10.2",
    "hono": "^4.12.3",
    "ioredis": "^5.10.0",
    "postgres": "^3.4.8",
    "zod": "^4.3.6"
  }
}
