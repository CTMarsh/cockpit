default_platform(:ios)

APP_IDENTIFIERS = [
  "com.ctmarsh.noahsark-cockpit",
  "com.ctmarsh.noahsark-cockpit.widgets"
]

platform :ios do
  before_all do
    setup_ci if is_ci
  end

  lane :build do
    sh("cd .. && xcodegen generate")

    if is_ci && ENV["APP_STORE_CONNECT_API_KEY_KEY"]
      key_content = File.read(ENV["APP_STORE_CONNECT_API_KEY_KEY"]).strip
      api_key = app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key_content: key_content,
        in_house: false
      )
    end

    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIERS,
      readonly: true,
      api_key: api_key
    )

    build_app(
      project: "CockpitApp.xcodeproj",
      scheme: "CockpitApp",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build"
    )
  end

  lane :beta do
    build
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  lane :release do
    build
    deliver(
      submit_for_review: false,
      force: true
    )
  end
end
