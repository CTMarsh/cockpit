default_platform(:ios)

APP_IDENTIFIERS = [
  "com.ctmarsh.noahsark-cockpit",
  "com.ctmarsh.noahsark-cockpit.widgets",
  "com.ctmarsh.noahsark-cockpit.watchkitapp"
]

platform :ios do
  before_all do
    setup_ci if is_ci
  end

  private_lane :setup_signing do
    if is_ci && ENV["APP_STORE_CONNECT_API_KEY_KEY"]
      key_content = File.read(ENV["APP_STORE_CONNECT_API_KEY_KEY"]).strip
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key_content: key_content,
        in_house: false
      )
    end

    # iOS profiles (main app + widget)
    match(
      type: "appstore",
      app_identifier: [
        "com.ctmarsh.noahsark-cockpit",
        "com.ctmarsh.noahsark-cockpit.widgets"
      ],
      readonly: is_ci ? false : true
    )

    # watchOS profile
    match(
      type: "appstore",
      platform: "watchos",
      app_identifier: ["com.ctmarsh.noahsark-cockpit.watchkitapp"],
      readonly: is_ci ? false : true
    )

    # Explicitly assign provisioning profiles to all targets
    [
      { target: "CockpitApp", bundle_id: "com.ctmarsh.noahsark-cockpit", identity: "iPhone Distribution" },
      { target: "CockpitWidgetExtension", bundle_id: "com.ctmarsh.noahsark-cockpit.widgets", identity: "iPhone Distribution" },
      { target: "CockpitWatch", bundle_id: "com.ctmarsh.noahsark-cockpit.watchkitapp", identity: "iPhone Distribution" }
    ].each do |t|
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "CockpitApp.xcodeproj",
        targets: [t[:target]],
        team_id: "WTPX4TSW4N",
        bundle_identifier: t[:bundle_id],
        profile_name: "match AppStore #{t[:bundle_id]}",
        code_sign_identity: t[:identity]
      )
    end
  end

  lane :build do
    sh("cd .. && xcodegen generate")
    setup_signing

    build_app(
      project: "CockpitApp.xcodeproj",
      scheme: "CockpitApp",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build"
    )
  end

  lane :beta do
    sh("cd .. && xcodegen generate")
    setup_signing

    # Auto-increment build number before building
    current = latest_testflight_build_number(
      app_identifier: "com.ctmarsh.noahsark-cockpit"
    )
    next_build = current + 1

    build_app(
      project: "CockpitApp.xcodeproj",
      scheme: "CockpitApp",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      xcargs: "CURRENT_PROJECT_VERSION=#{next_build}"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  lane :release do
    build
    deliver(
      submit_for_review: false,
      force: true
    )
  end
end
