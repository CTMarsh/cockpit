# Copy this to secret.yaml and fill in your real base64-encoded values
# To encode: echo -n 'your-value' | base64
# NEVER commit the real secret.yaml to git
apiVersion: v1
kind: Secret
metadata:
  name: cockpit-secrets
  namespace: cockpit
  labels:
    app.kubernetes.io/part-of: cockpit
type: Opaque
data:
  COCKPIT_USER: ""      # echo -n 'admin' | base64
  COCKPIT_PASS: ""      # echo -n 'your-password' | base64
  SESSION_SECRET: ""    # echo -n 'your-session-secret' | base64
